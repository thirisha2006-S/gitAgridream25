# AgriDream Environment Variables

# OpenAI API Key (for GPT features)
OPENAI_API_KEY=your_openai_api_key_here

# DeepAI API Key
DEEP_AI_API_KEY=your_deepai_api_key_here

# Plant.id API Key for Disease Detection
# Get your free API key at: https://web.plant.id/api-access-request/
PLANT_ID_API_KEY=your_plant_id_api_key_here

# Pl@ntNet API Key for Disease Detection (Alternative)
# Get your free API key at: https://my.plantnet.org/
# Sign up at https://my.plantnet.org/signup then go to /settings/api-key
PLANTNET_API_KEY=your_plantnet_api_key_here

# OpenWeatherMap API Key
OPENWEATHER_API_KEY=your_openweather_api_key_here

# CallMeBot API for WhatsApp Emergency Alerts
# Get API key at: https://www.callmebot.com/
CALLMEBOT_API_KEY=your_callmebot_api_key_here
CALLMEBOT_PHONE=your_phone_number_here

# AGMARKNET API Key for Price Forecasting
# Get your free API key at: https://data.gov.in/
DATA_GOV_IN_API_KEY=579b464db66ec23bdd0000019c162fc702704b767a58d3e8897d4328

# AgriDream Environment Variables

# OpenAI API Key (for GPT features)
OPENAI_API_KEY=your_openai_api_key_here

# DeepAI API Key
DEEP_AI_API_KEY=your_deepai_api_key_here

# Plant.id API Key for Disease Detection
# Get your free API key at: https://web.plant.id/api-access-request/
PLANT_ID_API_KEY=your_plant_id_api_key_here

# Pl@ntNet API Key for Disease Detection (Recommended - Free 500/day)
# Get your free API key at: https://my.plantnet.org/
# Sign up at https://my.plantnet.org/signup then go to /settings/api-key
# Demo key for testing - replace with your own key after signup
PLANTNET_API_KEY=demo_key

# OpenWeatherMap API Key (optional - app uses Open-Meteo which is free)
# Get your free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=21e959d85a5148fdd18fbb293869d9ef

# Fast2SMS API for Emergency SMS Alerts (India) - FREE
# Get your FREE API key at: https://www.fast2sms.com/
# 1. Go to https://www.fast2sms.com/
# 2. Sign up for free account
# 3. Go to Dashboard > Developer API
# 4. Copy your API key
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# AGMARKNET API Key for Price Forecasting
# Get your free API key at: https://data.gov.in/
DATA_GOV_IN_API_KEY=579b464db66ec23bdd0000019c162fc702704b767a58d3e8897d4328
